PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_URL=mongodb://127.0.0.1:27017/ecommerce_clone
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_at_least_32_character_secret_key
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gmail API (get these from Google Cloud Console -> OAuth 2.0 Desktop credentials)
# Used for all transactional emails: auth verification/reset, order confirmations,
# and the newsletter "thank you" welcome email.
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_USER=your-email@gmail.com