PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_URL=mongodb://127.0.0.1:27017/ecommerce_clone
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_at_least_32_character_secret_key
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email: choose SMTP (dev) or API (Render/production)
# For local development with Gmail or any SMTP provider:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# For Render/production (uncomment and set, comment out SMTP vars):
# EMAIL_API_KEY=re_your_resend_api_key
# SMTP_FROM=your-email@yourdomain.com
