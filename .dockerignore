# Dependencies are installed inside the Docker image.
node_modules
npm-debug.log*

# Never copy local secrets into the Docker image.
.env
.env.*
!.env.example

# Git and editor files are not needed inside the image.
.git
.gitignore
.vscode
.idea

# Test and local-only files are not needed in production image.
coverage
__tests__
jest.config.js
jest.setup.js

# OS generated files.
.DS_Store
Thumbs.db

# Log files.
*.log
logs
